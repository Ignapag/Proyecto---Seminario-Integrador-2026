# Copiar a .env y ajustar. El archivo .env no se versiona.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=monu
POSTGRES_PASSWORD=monu
POSTGRES_DB=monuburger

# --- Backend ---
DATABASE_URL=postgresql://monu:monu@localhost:5432/monuburger
ENTORNO=desarrollo
DEBUG=true
DB_TIMEOUT_CONEXION=5
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# --- Autenticacion (EDT 1.8 - Usuarios y Seguridad) ---
# En produccion esto tiene que venir de un secreto real, nunca del valor
# por defecto. Cambiarlo invalida todas las sesiones activas.
JWT_SECRET=clave-de-desarrollo-cambiar
JWT_EXP_MINUTOS=480
COOKIE_SESION=monu_session

# --- WhatsApp y Gemini (solo backend; guía docs/WHATSAPP_DESARROLLO.md) ---
WHATSAPP_MODO=simulado
WHATSAPP_NUMERO_NEGOCIO=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_DESTINATARIOS_PRUEBA_SIN_9=[]
WHATSAPP_TRANSFERENCIA_DATOS=
GEMINI_MODO=simulado
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
# Alternativos opt-in, solo modelos con tokens gratuitos verificados 20/10/2026.
# Ejemplo: ["gemini-3.1-flash-lite"]. La cuota depende del proyecto Free Tier.
# No activar facturación: el adaptador no administra el nivel de la cuenta.
GEMINI_MODELOS_ALTERNATIVOS=[]
# Presupuesto total compartido entre modelos, no se multiplica por cada uno.
GEMINI_MAX_INTENTOS=2
GEMINI_TIMEOUT=15
GEMINI_TIEMPO_TOTAL=20
# Demo local por entorno. La publicación autorizada se configura con el parámetro
# chat_demo_publico y scripts.serve; ver docs/WHATSAPP_DESARROLLO.md.
CHAT_DEMO_HABILITADO=false
CHAT_DEMO_BD_COMPARTIDA_AUTORIZADA=false

# --- Frontend (vacío usa el proxy /api de Vite) ---
VITE_API_URL=
